# Nunca subir el propio control de versiones ni archivos internos como
# "assets" servibles del sitio — wrangler.jsonc apunta la carpeta de
# assets a la raíz del repo ("./"), así que sin esto intenta escanear
# .git también.
.git
.git/**
.gitignore
.assetsignore
wrangler.jsonc

# backups de originales sin procesar — no son parte del sitio
originals/
assets/originals/

# reportes internos de /impeccable
.impeccable/

# sistema
.DS_Store
Thumbs.db
